<style>
@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap');

.stripe-page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #30313d;
  padding: 20px;
}

.stripe-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  width: 100%;
  max-width: 850px;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 15px 35px 0 rgba(60,66,87, 0.08), 0 5px 15px 0 rgba(0,0,0, 0.12);
  overflow: hidden;
  border: 1px solid #e3e8ee;
}

/* Left panel: Order Info */
.stripe-left-panel {
  background-color: #ffffff;
  padding: 48px;
  border-right: 1px solid #e3e8ee;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.stripe-merchant-title {
  color: #697386;
  font-size: 0.95rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
}

.stripe-amount-summary {
  margin-top: 24px;
}

.stripe-amount-val {
  font-size: 2.25rem;
  font-weight: 700;
  color: #1a1f36;
}

.stripe-order-items {
  margin-top: 30px;
}

.stripe-item-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  color: #3c4257;
  margin-bottom: 12px;
}

/* Right panel: Card Details form */
.stripe-right-panel {
  background-color: #ffffff;
  padding: 48px;
  display: flex;
  flex-direction: column;
}

.stripe-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #1a1f36;
  margin-bottom: 24px;
}

.stripe-input-group {
  margin-bottom: 20px;
}

.stripe-label {
  display: block;
  font-size: 0.85rem;
  font-weight: 500;
  color: #4f566b;
  margin-bottom: 8px;
}

.stripe-input {
  width: 100%;
  border: 1px solid #d9d9d9;
  border-radius: 4px;
  padding: 11px 12px;
  font-size: 0.95rem;
  color: #1a1f36;
  outline: none;
  box-shadow: rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(58, 151, 212, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(60, 66, 87, 0.16) 0px 1px 1px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(0, 0, 0, 0) 0px 0px 0px 0px, rgba(60, 66, 87, 0.08) 0px 0px 0px 1px;
  transition: box-shadow 0.15s ease-in-out;
}

.stripe-input:focus {
  box-shadow: rgba(58, 151, 212, 0.36) 0px 0px 0px 4px, rgba(60, 66, 87, 0.16) 0px 1px 1px 0px, #0070f3 0px 0px 0px 1px;
}

.stripe-btn-submit {
  background-color: #0070f3;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  font-size: 1rem;
  padding: 12px;
  cursor: pointer;
  transition: background-color 0.15s ease-in-out;
  box-shadow: 0 4px 6px rgba(50,50,93,.11), 0 1px 3px rgba(0,0,0,.08);
  margin-top: 10px;
}

.stripe-btn-submit:hover {
  background-color: #0062d6;
}

.stripe-btn-cancel {
  background-color: transparent;
  border: none;
  color: #697386;
  font-size: 0.88rem;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  margin-top: 20px;
  display: block;
}

.stripe-btn-cancel:hover {
  color: #1a1f36;
}

.sandbox-banner {
  background-color: #f59e0b;
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: inline-block;
  margin-top: 8px;
}
</style>

<div class="stripe-page">
  <div class="stripe-layout">
    <!-- Left Panel: Branded Details -->
    <div class="stripe-left-panel">
      <div>
        <div class="stripe-merchant-title">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="color: #6772e5;"><path d="M13.9 11.2c0-1-.8-1.4-2.2-1.4-1.3 0-2.8.4-3.9 1l-.5-3.3c1.4-.6 3.3-.9 5-.9 3.8 0 6 1.8 6 5.2 0 4.1-3.2 5.9-6.7 5.9-1.8 0-3.3-.3-4.3-.7l.5-3.2c1 .4 2.3.7 3.6.7 1.4 0 2.5-.5 2.5-1.3zM21.5 5.5l-2.4 13h-3.4l2.4-13h3.4zM9.5 5.5l-2.4 13H3.7l2.4-13h3.4z"/></svg>
          <strong>My Store Inc</strong>
        </div>

        <div class="stripe-amount-summary">
          <div class="stripe-amount-val"><%= number_to_currency(@order.total / 100.0) %></div>
          <span class="sandbox-banner">Stripe Test Mode</span>
        </div>

        <div class="stripe-order-items">
          <% @order.line_items.each do |item| %>
            <div class="stripe-item-row">
              <span><%= item.product.title %> &times; <%= item.quantity %></span>
              <strong><%= number_to_currency(item.total_price / 100.0) %></strong>
            </div>
          <% end %>
        </div>
      </div>

      <div style="font-size: 0.8rem; color: #8792a2;">
        Powered by <strong>Stripe</strong>
      </div>
    </div>

    <!-- Right Panel: Card Form -->
    <div class="stripe-right-panel">
      <h2 class="stripe-title">Pay with card</h2>

      <%= form_with(url: stripe_checkout_mock_success_path(order_id: @order.id), method: :post, local: true, class: "d-flex flex-column") do |f| %>
        <div class="stripe-input-group">
          <label class="stripe-label">Email</label>
          <input type="email" class="stripe-input" value="<%= @order.user.email %>" readonly>
        </div>

        <div class="stripe-input-group">
          <label class="stripe-label">Card Information</label>
          <input type="text" class="stripe-input" value="4242 4242 4242 4242" placeholder="Card Number" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;" required>
          <div style="display: grid; grid-template-columns: 1fr 1fr; margin-top: -1px;">
            <input type="text" class="stripe-input" value="12/28" placeholder="MM / YY" style="border-top-left-radius: 0; border-top-right-radius: 0; border-right-width: 0;" required>
            <input type="password" class="stripe-input" value="123" placeholder="CVC" style="border-top-left-radius: 0; border-top-right-radius: 0;" required>
          </div>
        </div>

        <div class="stripe-input-group">
          <label class="stripe-label">Name on Card</label>
          <input type="text" class="stripe-input" value="Albert Einstein" required>
        </div>

        <div class="stripe-input-group">
          <label class="stripe-label">Country or Region</label>
          <select class="stripe-input" style="background-color: white;">
            <option>United States</option>
            <option>India</option>
            <option>United Kingdom</option>
            <option>Canada</option>
          </select>
        </div>

        <%= f.submit "Pay #{number_to_currency(@order.total / 100.0)}", class: "stripe-btn-submit" %>
      <% end %>

      <%= link_to "Cancel and return", cancel_path(order_id: @order.id), class: "stripe-btn-cancel" %>
    </div>
  </div>
</div>
