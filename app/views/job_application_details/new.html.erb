<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

.upload-page-container {
  font-family: 'Plus Jakarta Sans', sans-serif;
  max-width: 1000px;
  margin: 32px auto;
  padding: 0 24px;
}

.upload-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  color: #f8fafc;
}

.page-title {
  font-size: 1.75rem;
  font-weight: 700;
  margin-top: 0;
  margin-bottom: 8px;
  background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.page-desc {
  color: #94a3b8;
  font-size: 0.95rem;
  margin-bottom: 28px;
}

.dropzone-box {
  border: 2px dashed #38bdf8;
  background: rgba(56, 189, 248, 0.03);
  border-radius: 14px;
  padding: 36px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 24px;
  position: relative;
}

.dropzone-box:hover {
  background: rgba(56, 189, 248, 0.08);
  border-color: #0284c7;
}

.dropzone-icon {
  width: 48px;
  height: 48px;
  color: #38bdf8;
  margin-bottom: 12px;
}

.file-input-hidden {
  display: none;
}

.btn-parse-trigger {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #ffffff;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  font-size: 0.95rem;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-parse-trigger:hover {
  background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
}

.parsing-status-box {
  display: none;
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 16px;
  border-radius: 10px;
  margin-bottom: 24px;
  color: #38bdf8;
  align-items: center;
  gap: 12px;
}

.spinner {
  width: 24px;
  height: 24px;
  border: 3px solid rgba(56, 189, 248, 0.3);
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 18px;
}

.form-group.full-width {
  grid-column: span 2;
}

.form-label {
  font-weight: 600;
  font-size: 0.88rem;
  color: #cbd5e1;
}

.form-control-custom {
  background: #0f172a;
  border: 1px solid #334155;
  color: #f8fafc;
  padding: 12px 14px;
  border-radius: 8px;
  font-size: 0.95rem;
  outline: none;
  font-family: inherit;
}

.form-control-custom:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
}

.exp-section-card {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 20px;
  margin-top: 10px;
  margin-bottom: 24px;
}

.exp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.exp-item-row {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr auto;
  gap: 10px;
  align-items: center;
}

.btn-remove-exp {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
}

.btn-add-exp {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 8px 16px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}

.json-preview-toggle {
  background: #0f172a;
  border: 1px solid #334155;
  color: #94a3b8;
  padding: 12px;
  border-radius: 8px;
  font-family: monospace;
  font-size: 0.85rem;
  max-height: 180px;
  overflow-y: auto;
  white-space: pre-wrap;
}

.btn-submit-main {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  border: none;
  padding: 14px 32px;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  width: 100%;
  box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);
  transition: all 0.2s ease;
}

.btn-submit-main:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(16, 185, 129, 0.6);
}
</style>

<div class="upload-page-container">
  <div class="upload-card">
    <h1 class="page-title">Candidate Job Application & Document Parser</h1>
    <p class="page-desc">Upload a candidate document (PDF, Word DOCX, Excel XLSX/CSV, or TXT) to automatically extract information using Python script parsing.</p>

    <!-- Document Upload Dropzone -->
    <div class="dropzone-box" onclick="document.getElementById('doc_file_input').click();">
      <svg class="dropzone-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
      <h3 style="margin: 0 0 4px 0; color: #f8fafc;">Click to select or drag candidate document file</h3>
      <p style="margin: 0; color: #94a3b8; font-size: 0.88rem;">Supports PDF, Word (.docx), Excel (.xlsx / .csv), and Text files</p>
      <div id="selected_file_name" style="margin-top: 12px; font-weight: 600; color: #38bdf8;"></div>
    </div>

    <input type="file" id="doc_file_input" class="file-input-hidden" accept=".pdf,.docx,.xlsx,.xls,.csv,.txt" onchange="handleFileSelect(event)">

    <div style="text-align: center; margin-bottom: 24px;">
      <button type="button" class="btn-parse-trigger" onclick="triggerPythonParser()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        Extract Details via Python Script
      </button>
    </div>

    <!-- Status Banner -->
    <div id="parsing_status" class="parsing-status-box">
      <div class="spinner"></div>
      <span id="parsing_status_text">Python Parser is reading document streams and extracting details...</span>
    </div>

    <!-- Main Job Application Form -->
    <%= form_with model: @job_application_detail, local: true, multipart: true, id: "job_app_form" do |f| %>
      <%= f.hidden_field :status, value: "parsed", id: "app_status_input" %>
      <input type="hidden" name="job_application_detail[experience_details_json]" id="experience_details_json_input" value="[]">

      <div class="form-grid">
        <div class="form-group">
          <%= f.label :name, "Candidate Full Name *", class: "form-label" %>
          <%= f.text_field :name, id: "field_name", class: "form-control-custom", placeholder: "e.g. John Doe", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email, id: "field_email", class: "form-control-custom", placeholder: "e.g. candidate@example.com" %>
        </div>

        <div class="form-group">
          <%= f.label :mobile_number, "Mobile Number *", class: "form-label" %>
          <%= f.text_field :mobile_number, id: "field_mobile", class: "form-control-custom", placeholder: "e.g. +1 555-0192 / 9876543210" %>
        </div>

        <div class="form-group">
          <%= f.label :resume_file, "Attach Original Document", class: "form-label" %>
          <%= f.file_field :resume_file, id: "form_resume_file", class: "form-control-custom" %>
        </div>

        <div class="form-group full-width">
          <%= f.label :skills, "Technical & Professional Skills", class: "form-label" %>
          <%= f.text_field :skills, id: "field_skills", class: "form-control-custom", placeholder: "e.g. Ruby on Rails, Python, SQL, React, Git" %>
        </div>
      </div>

      <!-- Experience Details Section (Saved as JSON in DB) -->
      <div class="exp-section-card">
        <div class="exp-header">
          <div>
            <h3 style="margin: 0; color: #f8fafc; font-size: 1.1rem;">Candidate Experience Details (JSON Format)</h3>
            <span style="font-size: 0.83rem; color: #94a3b8;">Multiple company experience history extracted automatically</span>
          </div>
          <button type="button" class="btn-add-exp" onclick="addExperienceRow()">+ Add Company Experience</button>
        </div>

        <div id="exp_items_container">
          <!-- Experience rows generated dynamically -->
        </div>

        <div style="margin-top: 12px;">
          <span class="form-label">Live JSON Payload Preview:</span>
          <pre id="json_preview" class="json-preview-toggle">[]</pre>
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group full-width">
          <%= f.label :education, "Education Details", class: "form-label" %>
          <%= f.text_area :education, id: "field_education", rows: 2, class: "form-control-custom", placeholder: "e.g. B.Tech Computer Science, University of Technology" %>
        </div>

        <div class="form-group full-width">
          <%= f.label :summary, "Executive Summary / Overview", class: "form-label" %>
          <%= f.text_area :summary, id: "field_summary", rows: 3, class: "form-control-custom", placeholder: "Extracted profile summary..." %>
        </div>
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="btn-submit-main">Save Job Application Details</button>
      </div>
    <% end %>
  </div>
</div>

<script>
let selectedFile = null;
let experienceList = [];

function handleFileSelect(event) {
  const files = event.target.files;
  if (files && files[0]) {
    selectedFile = files[0];
    document.getElementById("selected_file_name").innerText = "Selected File: " + selectedFile.name + " (" + (selectedFile.size / 1024).toFixed(1) + " KB)";
    
    // Copy to the file field inside form if empty
    const formFileInput = document.getElementById("form_resume_file");
    const container = new DataTransfer();
    container.items.add(selectedFile);
    formFileInput.files = container.files;

    // Automatically trigger parsing for seamless experience
    triggerPythonParser();
  }
}

function triggerPythonParser() {
  if (!selectedFile) {
    alert("Please select a document file first.");
    return;
  }

  const statusBox = document.getElementById("parsing_status");
  const statusText = document.getElementById("parsing_status_text");
  statusBox.style.display = "flex";
  statusText.innerText = "Python Script parsing document: " + selectedFile.name + "...";

  const formData = new FormData();
  formData.append("document", selectedFile);
  formData.append("authenticity_token", "<%= form_authenticity_token %>");

  fetch("<%= parse_document_job_application_details_path %>", {
    method: "POST",
    body: formData,
    headers: {
      "X-CSRF-Token": "<%= form_authenticity_token %>"
    }
  })
  .then(response => response.json())
  .then(res => {
    statusBox.style.display = "none";
    if (res.success && res.data) {
      const data = res.data;
      if (data.name) document.getElementById("field_name").value = data.name;
      if (data.email) document.getElementById("field_email").value = data.email;
      if (data.mobile_number) document.getElementById("field_mobile").value = data.mobile_number;
      if (data.skills) document.getElementById("field_skills").value = data.skills;
      if (data.education) document.getElementById("field_education").value = data.education;
      if (data.summary) document.getElementById("field_summary").value = data.summary;

      if (data.experience_details && Array.isArray(data.experience_details)) {
        experienceList = data.experience_details;
        renderExperienceRows();
      }
    } else {
      alert("Error parsing document: " + (res.error || "Unknown error"));
    }
  })
  .catch(err => {
    statusBox.style.display = "none";
    alert("Error executing Python document parser: " + err.message);
  });
}

function renderExperienceRows() {
  const container = document.getElementById("exp_items_container");
  container.innerHTML = "";

  experienceList.forEach((exp, idx) => {
    const row = document.createElement("div");
    row.className = "exp-item-row";
    row.innerHTML = `
      <div>
        <label class="form-label" style="font-size:0.75rem;">Company Name</label>
        <input type="text" class="form-control-custom" value="${exp.company_name || ''}" onchange="updateExpField(${idx}, 'company_name', this.value)" placeholder="Company">
      </div>
      <div>
        <label class="form-label" style="font-size:0.75rem;">Designation / Role</label>
        <input type="text" class="form-control-custom" value="${exp.designation || ''}" onchange="updateExpField(${idx}, 'designation', this.value)" placeholder="Role">
      </div>
      <div>
        <label class="form-label" style="font-size:0.75rem;">Start Date</label>
        <input type="text" class="form-control-custom" value="${exp.start_date || ''}" onchange="updateExpField(${idx}, 'start_date', this.value)" placeholder="Jan 2020">
      </div>
      <div>
        <label class="form-label" style="font-size:0.75rem;">End Date</label>
        <input type="text" class="form-control-custom" value="${exp.end_date || ''}" onchange="updateExpField(${idx}, 'end_date', this.value)" placeholder="Present">
      </div>
      <div>
        <label class="form-label" style="opacity:0;">Actions</label>
        <button type="button" class="btn-remove-exp" onclick="removeExpRow(${idx})">&times;</button>
      </div>
    `;
    container.appendChild(row);
  });

  updateJsonPayload();
}

function addExperienceRow() {
  experienceList.push({ company_name: "", designation: "", start_date: "", end_date: "" });
  renderExperienceRows();
}

function removeExpRow(idx) {
  experienceList.splice(idx, 1);
  renderExperienceRows();
}

function updateExpField(idx, field, value) {
  experienceList[idx][field] = value;
  updateJsonPayload();
}

function updateJsonPayload() {
  const jsonStr = JSON.stringify(experienceList, null, 2);
  document.getElementById("experience_details_json_input").value = JSON.stringify(experienceList);
  document.getElementById("json_preview").innerText = jsonStr;
}

// Initialize empty row if none exists
document.addEventListener("DOMContentLoaded", function() {
  if (experienceList.length === 0) {
    experienceList = [
      { company_name: "Chetu Software Solutions", designation: "Software Engineer", start_date: "2021", end_date: "Present" }
    ];
    renderExperienceRows();
  }
});
</script>
