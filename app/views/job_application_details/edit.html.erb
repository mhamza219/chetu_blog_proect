<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

.edit-page-container {
  font-family: 'Plus Jakarta Sans', sans-serif;
  max-width: 900px;
  margin: 32px auto;
  padding: 0 24px;
}

.edit-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  color: #f8fafc;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 18px;
}

.form-group.full-width {
  grid-column: span 2;
}

.form-label {
  font-weight: 600;
  font-size: 0.88rem;
  color: #cbd5e1;
}

.form-control-custom {
  background: #0f172a;
  border: 1px solid #334155;
  color: #f8fafc;
  padding: 12px 14px;
  border-radius: 8px;
  font-size: 0.95rem;
  outline: none;
}

.btn-update {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #ffffff;
  border: none;
  padding: 14px 32px;
  border-radius: 10px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  width: 100%;
}
</style>

<div class="edit-page-container">
  <div class="edit-card">
    <h1 style="margin-top: 0; color: #38bdf8;">Edit Candidate Application Details</h1>

    <%= form_with model: @job_application_detail, local: true do |f| %>
      <div class="form-grid">
        <div class="form-group">
          <%= f.label :name, "Candidate Name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control-custom", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email, class: "form-control-custom" %>
        </div>

        <div class="form-group">
          <%= f.label :mobile_number, "Mobile Number", class: "form-label" %>
          <%= f.text_field :mobile_number, class: "form-control-custom" %>
        </div>

        <div class="form-group">
          <%= f.label :status, "Application Status", class: "form-label" %>
          <%= f.select :status, [["Parsed", "parsed"], ["Draft", "draft"], ["Submitted", "submitted"], ["Under Review", "under_review"]], {}, class: "form-control-custom" %>
        </div>

        <div class="form-group full-width">
          <%= f.label :skills, "Skills", class: "form-label" %>
          <%= f.text_field :skills, class: "form-control-custom" %>
        </div>

        <div class="form-group full-width">
          <%= f.label :education, "Education", class: "form-label" %>
          <%= f.text_area :education, rows: 2, class: "form-control-custom" %>
        </div>

        <div class="form-group full-width">
          <%= f.label :summary, "Summary", class: "form-label" %>
          <%= f.text_area :summary, rows: 3, class: "form-control-custom" %>
        </div>
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="btn-update">Update Candidate Profile</button>
      </div>
    <% end %>
  </div>
</div>
