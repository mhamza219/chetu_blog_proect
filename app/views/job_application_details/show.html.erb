<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

.candidate-profile-container {
  font-family: 'Plus Jakarta Sans', sans-serif;
  max-width: 1000px;
  margin: 32px auto;
  padding: 0 24px;
}

.profile-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  color: #f8fafc;
  margin-bottom: 24px;
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px solid #334155;
  padding-bottom: 24px;
  margin-bottom: 24px;
}

.candidate-title-name {
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 6px 0;
  background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.meta-info-row {
  display: flex;
  gap: 20px;
  color: #94a3b8;
  font-size: 0.95rem;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.section-heading {
  font-size: 1.2rem;
  font-weight: 700;
  color: #f8fafc;
  margin: 24px 0 16px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.experience-timeline {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}

.exp-card-item {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.exp-role-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #38bdf8;
}

.exp-company-name {
  font-size: 0.95rem;
  color: #cbd5e1;
  font-weight: 500;
}

.exp-date-badge {
  background: rgba(56, 189, 248, 0.1);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.2);
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
}

.skills-badge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}

.skill-tag {
  background: #334155;
  color: #f8fafc;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.88rem;
  font-weight: 500;
}

.json-box-display {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 16px;
  color: #38bdf8;
  font-family: monospace;
  font-size: 0.88rem;
  white-space: pre-wrap;
  max-height: 250px;
  overflow-y: auto;
}

.btn-nav-back {
  background: #334155;
  color: #f8fafc;
  text-decoration: none;
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-nav-back:hover {
  background: #475569;
  color: #f8fafc;
  text-decoration: none;
}
</style>

<div class="candidate-profile-container">
  <div class="profile-card">
    <div class="profile-header">
      <div>
        <h1 class="candidate-title-name"><%= @job_application_detail.name %></h1>
        <div class="meta-info-row">
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <%= @job_application_detail.email.presence || "No Email Provided" %>
          </div>
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <%= @job_application_detail.mobile_number.presence || "No Mobile Provided" %>
          </div>
          <% if @job_application_detail.resume_file_name.present? %>
            <div class="meta-item" style="color: #38bdf8;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              <%= @job_application_detail.resume_file_name %>
            </div>
          <% end %>
        </div>
      </div>
      <div>
        <%= link_to edit_job_application_detail_path(@job_application_detail), class: "btn-nav-back", style: "background: rgba(56,189,248,0.15); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3);" do %>
          Edit Profile
        <% end %>
      </div>
    </div>

    <!-- Candidate Experience Details (JSON Breakdown) -->
    <h3 class="section-heading">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
      Work Experience Details (Extracted & Stored as JSON)
    </h3>

    <div class="experience-timeline">
      <% if @job_application_detail.experience_details.is_a?(Array) && @job_application_detail.experience_details.any? %>
        <% @job_application_detail.experience_details.each do |exp| %>
          <div class="exp-card-item">
            <div>
              <div class="exp-role-title"><%= exp["designation"] || exp[:designation] || "Software Professional" %></div>
              <div class="exp-company-name"><%= exp["company_name"] || exp[:company_name] || "Company Name" %></div>
            </div>
            <div>
              <span class="exp-date-badge">
                <%= exp["start_date"] || exp[:start_date] || "Start" %> - <%= exp["end_date"] || exp[:end_date] || "End" %>
              </span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div style="color: #94a3b8; font-style: italic;">No work experience entries recorded.</div>
      <% end %>
    </div>

    <!-- Skills Tag List -->
    <h3 class="section-heading">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      Technical & Key Skills
    </h3>
    <div class="skills-badge-list">
      <% if @job_application_detail.skills.present? %>
        <% @job_application_detail.skills.split(',').each do |skill| %>
          <span class="skill-tag"><%= skill.strip %></span>
        <% end %>
      <% else %>
        <span style="color: #94a3b8;">N/A</span>
      <% end %>
    </div>

    <!-- Education & Overview -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
      <div>
        <h3 class="section-heading" style="margin-top: 0;">Education</h3>
        <p style="color: #cbd5e1; line-height: 1.6;"><%= @job_application_detail.education.presence || "N/A" %></p>
      </div>
      <div>
        <h3 class="section-heading" style="margin-top: 0;">Summary Overview</h3>
        <p style="color: #cbd5e1; line-height: 1.6;"><%= @job_application_detail.summary.presence || "N/A" %></p>
      </div>
    </div>

    <!-- Raw JSON Database Viewer -->
    <h3 class="section-heading">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
      Database JSON Column Payload (experience_details)
    </h3>
    <pre class="json-box-display"><%= JSON.pretty_generate(@job_application_detail.experience_details || []) %></pre>

    <!-- PaperTrail Audit Trail Version History -->
    <h3 class="section-heading" style="margin-top: 32px;">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      PaperTrail Audit Trail & Change History (<%= @job_application_detail.versions.count %> Versions)
    </h3>
    <div style="background: #0f172a; border: 1px solid #334155; border-radius: 12px; padding: 16px;">
      <% if @job_application_detail.versions.any? %>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @job_application_detail.versions.reverse.each do |version| %>
            <li style="padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 0.88rem; color: #cbd5e1; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <span style="font-weight: 700; color: #38bdf8; text-transform: uppercase; margin-right: 8px;">
                  Event: <%= version.event %>
                </span>
                <span>Version #<%= version.id %> created on <%= version.created_at.strftime("%B %d, %Y at %I:%M %p") %></span>
              </div>
              <div style="font-size: 0.8rem; color: #94a3b8;">
                <%= version.whodunnit.present? ? "By User ##{version.whodunnit}" : "System / Automated" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div style="color: #94a3b8; font-size: 0.88rem; font-style: italic;">No audit history recorded yet.</div>
      <% end %>
    </div>
  </div>


  <div>
    <%= link_to job_application_details_path, class: "btn-nav-back" do %>
      &larr; Back to All Candidate Applications
    <% end %>
  </div>
</div>
