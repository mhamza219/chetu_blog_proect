<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

.profile-container {
  font-family: 'Outfit', sans-serif;
  background-color: #0b141a;
  min-height: calc(100vh - 56px);
  padding: 40px 20px;
  color: #e9edef;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  background-image: radial-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 0);
  background-size: 24px 24px;
}

.profile-card {
  width: 100%;
  max-width: 650px;
  background: rgba(32, 44, 51, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 40px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.profile-title {
  font-size: 2.25rem;
  font-weight: 700;
  background: linear-gradient(135deg, #0d9488 0%, #06b6d4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 30px;
  text-align: center;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 35px;
}

.avatar-wrapper {
  position: relative;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid #0d9488;
  background-color: #111b21;
  box-shadow: 0 4px 15px rgba(13, 148, 136, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.avatar-wrapper:hover {
  transform: scale(1.03);
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-initials {
  font-size: 3rem;
  font-weight: 700;
  color: #aebac1;
  background: linear-gradient(135deg, #202c33 0%, #111b21 100%);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-upload-label {
  margin-top: 15px;
  background-color: rgba(13, 148, 136, 0.15);
  color: #0d9488;
  border: 1px solid rgba(13, 148, 136, 0.3);
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.avatar-upload-label:hover {
  background-color: #0d9488;
  color: #ffffff;
}

.wa-form-group {
  margin-bottom: 24px;
}

.wa-label {
  display: block;
  font-size: 0.9rem;
  font-weight: 500;
  color: #8696a0;
  margin-bottom: 8px;
}

.wa-input {
  width: 100%;
  background-color: #2a3942;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  color: #e9edef;
  font-size: 0.98rem;
  padding: 11px 16px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.wa-input:focus {
  border-color: #0d9488;
  box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.25);
}

.wa-select {
  width: 100%;
  background-color: #2a3942;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  color: #e9edef;
  font-size: 0.98rem;
  padding: 11px 16px;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238696a0' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 16px center;
  background-size: 16px;
  cursor: pointer;
}

.wa-select:focus {
  border-color: #0d9488;
}

.submit-btn {
  background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1.05rem;
  padding: 12px 24px;
  width: 100%;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 10px;
  box-shadow: 0 4px 12px rgba(13, 148, 136, 0.2);
}

.submit-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(13, 148, 136, 0.35);
}

.submit-btn:active {
  transform: translateY(0);
}

.notice-box {
  background-color: rgba(13, 148, 136, 0.15);
  border: 1px solid rgba(13, 148, 136, 0.4);
  color: #0d9488;
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 25px;
  font-weight: 500;
  text-align: center;
}
</style>

<div class="profile-container">
  <div class="profile-card">
    <h2 class="profile-title">Manage Profile</h2>

    <% if flash[:notice] %>
      <div class="notice-box">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with(model: @user, url: profile_path, method: :patch, local: true, class: "w-100") do |f| %>
      <div class="avatar-section">
        <div class="avatar-wrapper">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "avatar-image", id: "avatar-preview" %>
          <% else %>
            <div class="avatar-initials" id="avatar-preview-placeholder">
              <%= @user.email.first(2).upcase %>
            </div>
          <% end %>
        </div>
        
        <label for="user_avatar" class="avatar-upload-label">
          Change Photo
        </label>
        <%= f.file_field :avatar, accept: "image/*", class: "d-none", onchange: "previewImage(this);" %>
      </div>

      <div class="wa-form-group">
        <%= f.label :display_name, "Full Name", class: "wa-label" %>
        <%= f.text_field :display_name, placeholder: "e.g. John Doe", class: "wa-input" %>
      </div>

      <div class="wa-form-group">
        <%= f.label :phone_number, "Phone Number", class: "wa-label" %>
        <%= f.text_field :phone_number, placeholder: "e.g. +1234567890", class: "wa-input" %>
      </div>

      <div class="wa-form-group">
        <%= f.label :gender, "Gender", class: "wa-label" %>
        <%= f.select :gender, ["Male", "Female", "Other"], { include_blank: "Select Gender" }, class: "wa-select" %>
      </div>

      <div class="wa-form-group">
        <%= f.label :address, "Address (Geocoded)", class: "wa-label" %>
        <%= f.text_area :address, rows: 2, placeholder: "e.g. 1600 Amphitheatre Pkwy, Mountain View, CA", class: "wa-input" %>
      </div>

      <div class="wa-form-group p-3 rounded" style="background: rgba(13, 148, 136, 0.08); border: 1px dashed rgba(13, 148, 136, 0.3);">
        <label class="wa-label" style="color: #06b6d4; font-weight: 600; margin-bottom: 6px;">📍 Geocoder Location Status</label>
        <div class="d-flex flex-column gap-1 mb-2" style="font-size: 0.9rem; color: #aebac1;">
          <div><strong>Current Location:</strong> <span id="profile-location-str" style="color: #e9edef;"><%= @user.formatted_location.presence || "Not set yet" %></span></div>
          <div><strong>Latitude:</strong> <span id="profile-lat" style="color: #0d9488;"><%= @user.latitude || "N/A" %></span> | <strong>Longitude:</strong> <span id="profile-lng" style="color: #0d9488;"><%= @user.longitude || "N/A" %></span></div>
        </div>
        <button type="button" class="btn btn-sm text-white mt-1" style="background-color: #0d9488; font-weight: 500;" onclick="detectAndSaveLocation()">
          🌐 Update Location via Browser GPS
        </button>
      </div>

      <%= f.submit "Save Changes", class: "submit-btn" %>
    <% end %>
  </div>
</div>

<script>
function detectAndSaveLocation() {
  if ("geolocation" in navigator) {
    const locStr = document.getElementById("profile-location-str");
    if (locStr) locStr.innerText = "Detecting GPS location...";

    navigator.geolocation.getCurrentPosition(function(position) {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;
      const csrfToken = document.querySelector("meta[name='csrf-token']")?.getAttribute("content");

      fetch("<%= update_user_location_path %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({ latitude: lat, longitude: lng })
      })
      .then(res => res.json())
      .then(data => {
        if (data.status === "success") {
          document.getElementById("profile-lat").innerText = data.latitude;
          document.getElementById("profile-lng").innerText = data.longitude;
          document.getElementById("profile-location-str").innerText = data.location;
          const navText = document.getElementById("nav-location-text");
          if (navText) navText.innerText = data.location;
        } else {
          alert("Could not update location: " + (data.message || "Unknown error"));
        }
      })
      .catch(err => alert("Error saving location: " + err));
    }, function(err) {
      alert("Browser Geolocation Error: " + err.message);
    });
  } else {
    alert("Geolocation is not supported by your browser.");
  }
}
</script>

<script>
function previewImage(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      // Find or create image element
      let img = document.getElementById("avatar-preview");
      if (!img) {
        const placeholder = document.getElementById("avatar-preview-placeholder");
        if (placeholder) {
          placeholder.remove();
        }
        img = document.createElement("img");
        img.id = "avatar-preview";
        img.className = "avatar-image";
        document.querySelector(".avatar-wrapper").appendChild(img);
      }
      img.src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }
}
</script>
