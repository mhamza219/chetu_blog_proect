<div id="message_form" class="w-100">
  <%= form_with model: [room, Message.new], class: "d-flex align-items-center w-100 gap-3" do |f| %>
    <div class="input-bar-wrapper flex-grow-1">
      <%= f.text_field :context, placeholder: "Type a message...", class: "wa-input-bar", autocomplete: "off", required: true %>
    </div>
    <button type="submit" class="wa-send-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-send"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
    </button>
  <% end %>
</div>
