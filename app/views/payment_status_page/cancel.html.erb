<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

.cancel-container {
  font-family: 'Outfit', sans-serif;
  background-color: #0b141a;
  min-height: calc(100vh - 56px);
  padding: 50px 20px;
  color: #e9edef;
  display: flex;
  justify-content: center;
  align-items: center;
  background-image: radial-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 0);
  background-size: 24px 24px;
}

.cancel-card {
  width: 100%;
  max-width: 550px;
  background: rgba(32, 44, 51, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 40px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  text-align: center;
  animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.cancel-icon-wrapper {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background-color: rgba(239, 68, 68, 0.1);
  border: 2px solid #ef4444;
  color: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px auto;
  box-shadow: 0 0 20px rgba(239, 68, 68, 0.35);
}

.cancel-title {
  font-size: 2.2rem;
  font-weight: 700;
  color: #e9edef;
  margin-bottom: 8px;
}

.cancel-subtitle {
  color: #8696a0;
  font-size: 1rem;
  margin-bottom: 30px;
}

.cancel-alert-box {
  background-color: rgba(239, 68, 68, 0.05);
  border: 1px solid rgba(239, 68, 68, 0.15);
  color: #ef4444;
  padding: 16px;
  border-radius: 8px;
  margin-bottom: 30px;
  font-size: 0.95rem;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.btn-primary-cancel {
  background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  padding: 12px;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 4px 10px rgba(13, 148, 136, 0.2);
  text-decoration: none;
  display: inline-block;
}

.btn-primary-cancel:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 15px rgba(13, 148, 136, 0.35);
  color: #ffffff;
  text-decoration: none;
}

.btn-secondary-cancel {
  background-color: rgba(255, 255, 255, 0.04);
  color: #aebac1;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  padding: 12px;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  display: inline-block;
}

.btn-secondary-cancel:hover {
  background-color: rgba(255, 255, 255, 0.08);
  color: #e9edef;
  text-decoration: none;
}
</style>

<div class="cancel-container">
  <div class="cancel-card">
    <div class="cancel-icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </div>

    <h1 class="cancel-title">Payment Cancelled</h1>
    <p class="cancel-subtitle">The payment process was interrupted or cancelled by the user.</p>

    <div class="cancel-alert-box">
      No funds have been charged from your account for this transaction.
    </div>

    <div class="action-buttons">
      <%= link_to "Retry Checkout", checkout_path, class: "btn-primary-cancel" %>
      <%= link_to "Return to Shop", root_path, class: "btn-secondary-cancel" %>
    </div>
  </div>
</div>
