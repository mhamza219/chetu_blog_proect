<style>
.call-overlay-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(11, 20, 26, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 9999;
  display: none;
  justify-content: center;
  align-items: center;
  animation: callFadeIn 0.3s ease-out;
}

@keyframes callFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.call-window-card {
  width: 100%;
  max-width: 680px;
  height: 520px;
  background-color: #111b21;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
}

.call-header-info {
  position: absolute;
  top: 24px;
  left: 24px;
  right: 24px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 4px;
  pointer-events: none;
}

.call-user-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #e9edef;
  text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

.call-status-label {
  font-size: 0.9rem;
  color: #aebac1;
  text-shadow: 0 1px 2px rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  gap: 6px;
}

.call-status-dot {
  width: 8px;
  height: 8px;
  background-color: #25d366;
  border-radius: 50%;
  animation: dotPulse 1.5s infinite;
}

@keyframes dotPulse {
  0% { transform: scale(0.9); opacity: 0.6; }
  50% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.6; }
}

/* Video Canvas & Elements */
.remote-video-wrapper {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  background-color: #1a2329;
  z-index: 1;
}

.remote-video-element {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.local-video-wrapper {
  width: 130px;
  height: 180px;
  background-color: #202c33;
  border: 2px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  position: absolute;
  bottom: 24px;
  right: 24px;
  z-index: 5;
  overflow: hidden;
  box-shadow: 0 8px 16px rgba(0,0,0,0.3);
}

.local-video-element {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scaleX(-1); /* mirror */
}

/* Floating Controls Footer */
.call-controls-panel {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  gap: 16px;
  background-color: rgba(32, 44, 51, 0.75);
  backdrop-filter: blur(10px);
  padding: 10px 20px;
  border-radius: 30px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.btn-control-active {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: none;
  background-color: rgba(255, 255, 255, 0.12);
  color: #e9edef;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-control-active:hover {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
}

.btn-control-muted {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: none;
  background-color: #ef4444;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-decline {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: none;
  background-color: #ea4335;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-decline:hover {
  background-color: #d93025;
  transform: scale(1.05);
}

/* Incoming Call Request popup container */
.incoming-call-box {
  background: rgba(32, 44, 51, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 24px;
  width: 320px;
  text-align: center;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  box-shadow: 0 15px 30px rgba(0,0,0,0.4);
  animation: boxZoom 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes boxZoom {
  from { transform: translate(-50%, -50%) scale(0.8); opacity: 0; }
  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

.incoming-title {
  font-size: 1.15rem;
  font-weight: 600;
  color: #e9edef;
  margin-bottom: 8px;
}

.incoming-subtitle {
  font-size: 0.88rem;
  color: #8696a0;
  margin-bottom: 20px;
}

.incoming-actions {
  display: flex;
  justify-content: center;
  gap: 16px;
}

.btn-accept {
  background-color: #25d366;
  color: #ffffff;
  border: none;
  border-radius: 20px;
  padding: 8px 20px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-accept:hover {
  background-color: #20ba59;
  transform: scale(1.05);
}
</style>

<div class="call-overlay-container" data-call-target="overlay">
  <div class="call-window-card">
    
    <!-- Top details -->
    <div class="call-header-info">
      <div class="call-user-title" data-call-target="callerName">Albert Einstein</div>
      <div class="call-status-label">
        <span class="call-status-dot"></span>
        <span data-call-target="status">Calling...</span>
      </div>
    </div>

    <!-- Remote Stream View -->
    <div class="remote-video-wrapper">
      <video id="remote-video" class="remote-video-element d-none" data-call-target="remoteVideo" autoplay playsinline></video>
    </div>

    <!-- Local Stream PIP View -->
    <div class="local-video-wrapper">
      <video id="local-video" class="local-video-element d-none" data-call-target="localVideo" autoplay playsinline muted></video>
    </div>

    <!-- Floating Buttons Panel -->
    <div class="call-controls-panel">
      <!-- Mute Mic -->
      <button class="btn-control-active" data-call-target="audioBtn" data-action="click->call#toggleMuteAudio" title="Mute Audio">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mic"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v1a7 7 0 0 1-14 0v-1"></path><line x1="12" y1="19" x2="12" y2="23"></line></svg>
      </button>

      <!-- Toggle Camera -->
      <button class="btn-control-active" data-call-target="videoBtn" data-action="click->call#toggleMuteVideo" title="Mute Video">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-video"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
      </button>

      <!-- Decline/Hangup -->
      <button class="btn-decline" data-action="click->call#hangup" title="End Call">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="feather feather-phone-off" style="transform: rotate(135deg);"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-5.85-5.85A19.79 19.79 0 0 1 1 3.5a2 2 0 0 1 2-1.72h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 2.6 3.4z"></path><line x1="23" y1="1" x2="1" y2="23"></line></svg>
      </button>
    </div>

    <!-- Incoming Call Request Popup -->
    <div class="incoming-call-box d-none" data-call-target="incomingCallBox">
      <div class="incoming-title">Incoming Call</div>
      <div class="incoming-subtitle">Accept to connect video call</div>
      <div class="incoming-actions">
        <button class="btn-accept" data-action="click->call#acceptCall">Accept</button>
        <button class="btn-decline" style="padding: 8px 20px; border-radius: 20px;" data-action="click->call#declineCall">Decline</button>
      </div>
    </div>

  </div>
</div>
