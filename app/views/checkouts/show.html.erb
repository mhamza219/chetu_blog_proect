<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

.checkout-container {
  font-family: 'Outfit', sans-serif;
  background-color: #0b141a;
  min-height: calc(100vh - 56px);
  padding: 40px 20px;
  color: #e9edef;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  background-image: radial-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 0);
  background-size: 24px 24px;
}

.checkout-layout {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 30px;
  width: 100%;
  max-width: 1100px;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

.checkout-card {
  background: rgba(32, 44, 51, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 30px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
}

.checkout-section-title {
  font-size: 1.4rem;
  font-weight: 600;
  color: #e9edef;
  margin-bottom: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Address details card */
.address-info {
  background-color: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 24px;
}

.address-label {
  font-size: 0.85rem;
  color: #8696a0;
  font-weight: 500;
}

.address-val {
  font-size: 0.98rem;
  color: #e9edef;
  margin-top: 4px;
}

.address-missing-alert {
  background-color: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #ef4444;
  padding: 12px 16px;
  border-radius: 8px;
  font-size: 0.9rem;
  margin-bottom: 20px;
}

/* Gateway selection cards */
.gateway-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 30px;
}

.gateway-card {
  background-color: rgba(255, 255, 255, 0.03);
  border: 2px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 20px;
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.gateway-card:hover {
  background-color: rgba(255, 255, 255, 0.06);
  border-color: rgba(13, 148, 136, 0.3);
}

.gateway-card.selected {
  background-color: rgba(13, 148, 136, 0.08);
  border-color: #0d9488;
}

.gateway-radio {
  position: absolute;
  top: 12px;
  right: 12px;
  accent-color: #0d9488;
}

.gateway-icon {
  width: 48px;
  height: 48px;
  margin-bottom: 12px;
  color: #aebac1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gateway-card.selected .gateway-icon {
  color: #0d9488;
}

.gateway-name {
  font-weight: 600;
  font-size: 1rem;
  color: #e9edef;
}

.gateway-desc {
  font-size: 0.8rem;
  color: #8696a0;
  margin-top: 4px;
}

/* Order summary box */
.order-summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.order-summary-item:last-child {
  border-bottom: none;
}

.checkout-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20px;
  margin-top: 10px;
  border-top: 2px solid rgba(255, 255, 255, 0.06);
  font-size: 1.25rem;
  font-weight: 700;
  color: #e9edef;
}

.pay-now-btn {
  background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1.1rem;
  padding: 14px;
  width: 100%;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 15px rgba(13, 148, 136, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.pay-now-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(13, 148, 136, 0.4);
}

.edit-profile-btn-link {
  color: #0d9488;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: opacity 0.2s;
}

.edit-profile-btn-link:hover {
  opacity: 0.9;
  text-decoration: underline;
}
</style>

<div class="checkout-container">
  <%= form_with(url: checkout_path, method: :post, local: true, class: "checkout-layout") do |f| %>
    <!-- Left Column: Shipping & Payment Method -->
    <div class="d-flex flex-column gap-4">
      <div class="checkout-card">
        <div class="checkout-section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-map-pin"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Delivery Details</span>
        </div>

        <% if @user.address.blank? || @user.phone_number.blank? %>
          <div class="address-missing-alert">
            Shipping details are incomplete. Please <%= link_to "update your profile", edit_profile_path, class: "edit-profile-btn-link" %> before placing an order.
          </div>
        <% end %>

        <div class="address-info">
          <div class="address-label">Delivery Address</div>
          <div class="address-val">
            <%= @user.address.present? ? @user.address : "No shipping address set. Click Edit Profile." %>
          </div>
        </div>

        <div class="address-info">
          <div class="address-label">Contact Phone</div>
          <div class="address-val">
            <%= @user.phone_number.present? ? @user.phone_number : "No phone number set." %>
          </div>
        </div>
      </div>

      <div class="checkout-card">
        <div class="checkout-section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-credit-card"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          <span>Select Payment Method</span>
        </div>

        <div class="gateway-options">
          <!-- Stripe Gateway Card -->
          <div class="gateway-card selected" onclick="selectGateway('stripe')">
            <input type="radio" name="payment_gateway" value="stripe" id="gw_stripe" checked class="gateway-radio" onclick="event.stopPropagation();">
            <div class="gateway-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M13.9 11.2c0-1-.8-1.4-2.2-1.4-1.3 0-2.8.4-3.9 1l-.5-3.3c1.4-.6 3.3-.9 5-.9 3.8 0 6 1.8 6 5.2 0 4.1-3.2 5.9-6.7 5.9-1.8 0-3.3-.3-4.3-.7l.5-3.2c1 .4 2.3.7 3.6.7 1.4 0 2.5-.5 2.5-1.3zM21.5 5.5l-2.4 13h-3.4l2.4-13h3.4zM9.5 5.5l-2.4 13H3.7l2.4-13h3.4z"/></svg>
            </div>
            <div class="gateway-name">Stripe</div>
            <div class="gateway-desc">Pay with Credit / Debit Card</div>
          </div>

          <!-- Cashfree Gateway Card -->
          <div class="gateway-card" onclick="selectGateway('cashfree')">
            <input type="radio" name="payment_gateway" value="cashfree" id="gw_cashfree" class="gateway-radio" onclick="event.stopPropagation();">
            <div class="gateway-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
            </div>
            <div class="gateway-name">Cashfree</div>
            <div class="gateway-desc">UPI, Netbanking, Cards</div>
          </div>

          <!-- Razorpay Gateway Card -->
          <div class="gateway-card" onclick="selectGateway('razorpay')">
            <input type="radio" name="payment_gateway" value="razorpay" id="gw_razorpay" class="gateway-radio" onclick="event.stopPropagation();">
            <div class="gateway-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
            </div>
            <div class="gateway-name">Razorpay</div>
            <div class="gateway-desc">Secure Instant UPI & Cards</div>
          </div>

          <!-- BillDesk Gateway Card -->
          <div class="gateway-card" onclick="selectGateway('billdesk')">
            <input type="radio" name="payment_gateway" value="billdesk" id="gw_billdesk" class="gateway-radio" onclick="event.stopPropagation();">
            <div class="gateway-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M4 4h16v16H4V4zm2 4h12v2H6V8zm0 4h12v2H6v-2zm0 4h8v2H6v-2z"/></svg>
            </div>
            <div class="gateway-name">BillDesk</div>
            <div class="gateway-desc">Popular Indian Banks Banking</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Order Summary & Place Order -->
    <div class="checkout-card d-flex flex-column justify-content-between" style="align-self: start;">
      <div>
        <div class="checkout-section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-bag"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span>Order Summary</span>
        </div>

        <div class="mb-4">
          <% @cart.line_items.each do |item| %>
            <div class="order-summary-item">
              <div>
                <span style="font-weight: 500;"><%= item.product.title %></span>
                <div style="font-size: 0.82rem; color: #8696a0;">Qty: <%= item.quantity %></div>
              </div>
              <div style="font-weight: 500;">
                <%= number_to_currency(item.total_price / 100.0) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div>
        <div class="checkout-total-row">
          <span>Grand Total</span>
          <span style="color: #0d9488;"><%= number_to_currency(@cart.total_price / 100.0) %></span>
        </div>

        <div class="mt-4">
          <%= f.submit "Place Order & Pay", class: "pay-now-btn", disabled: (@user.address.blank? || @user.phone_number.blank?) %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
function selectGateway(gatewayId) {
  // Deselect all cards
  document.querySelectorAll('.gateway-card').forEach(card => {
    card.classList.remove('selected');
  });

  // Select clicked card and its radio button
  const card = event.currentTarget;
  card.classList.add('selected');
  
  const radio = document.getElementById('gw_' + gatewayId);
  if (radio) {
    radio.checked = true;
  }
}
</script>
